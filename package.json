{
  "name": "pioneer-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types --lang typescript --local --schema public > src/server/db/database.types.ts && prettier --write src/server/db/database.types.ts",
    "bootstrap:owner": "tsx --env-file=.env.local scripts/bootstrap-owner.ts",
    "worker": "tsx --env-file=.env.worker worker/index.ts",
    "worker:setup-local": "tsx scripts/worker-local-setup.ts",
    "worker:setup-hosted": "tsx scripts/worker-hosted-setup.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vinext/cloudflare": "^1.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "vinext": "^1.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "otpauth": "9.5.2",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "5.0.5",
    "webpack": "^5.112.2"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "fsevents": false,
    "workerd@1.20261104.1": true
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
