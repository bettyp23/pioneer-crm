# Pioneer worker settings (M8). Copy to .env.worker on your Mac (git ignores it).
# Read only by `npm run worker`, never by the app. Never paste these values into a chat.

# Set by `npm run worker:setup-local` (local database, restricted pioneer_worker role)
WORKER_DATABASE_URL=

# Claude: the "Pioneer brain" scheduled task (claude.ai/code/routines → API trigger)
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=

# Grok: Michael Scott's "Pioneer OS task intake" routine
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=

# Google: read-only access to the Agency Dashboard sheet (m8-setup runbook on the archive/full-pioneer-os branch)
GOOGLE_SHEETS_KEY_FILE=
AGENCY_SHEET_ID=
AGENCY_SHEET_TAB=Pioneer Results

# Hosted database only: set by `npm run worker:setup-hosted` (docs/runbooks/hosted-setup.md)
WORKER_DATABASE_CA_FILE=
# The shared "Pioneer Results" Drive folder (one new file per reply)
AGENCY_RESULTS_FOLDER_ID=
